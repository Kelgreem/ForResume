//Cоздаем запись в регистре сведений для счета учетов расчетов с контрагентами для определенного контрагента
НаборЗаписей = РегистрыСведений.СчетаУчетаРасчетовСКонтрагентами.СоздатьНаборЗаписей();
НаборЗаписейТЗ = НаборЗаписей.Выгрузить();
Для каждого СтрокаТЗ из ТЗ Цикл
                Если Не ЗначениеЗаполнено(СтрокаТЗ.СсылкаКонтрагент) Тогда
                               Продолжить;
                КонецЕсли;
                //НаборЗаписей.Отбор.Контрагент.Установить(СтрокаТЗ.Контрагент);
                НоваяЗапись = НаборЗаписейТЗ.Добавить();
                НоваяЗапись.Организация = Справочники.Организации.НайтиПоНаименованию("%");
                НоваяЗапись.Контрагент = СтрокаТЗ.СсылкаКонтрагент;//ОбъектКонтрагент.Ссылка;
                НоваяЗапись.Договор = БухгалтерскийУчетПереопределяемый.ПолучитьПустоеЗначениеДоговора();
                НоваяЗапись.ВидРасчетовПоДоговору = Перечисления.ВидыРасчетовПоДоговорам.РасчетыВВалютеРегламентированногоУчета;
                НоваяЗапись.СчетУчетаРасчетовСПоставщиком = ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.1");
                НоваяЗапись.СчетУчетаАвансовВыданных = ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.2");
                НоваяЗапись.СчетУчетаРасчетовСПокупателем = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.1");
                НоваяЗапись.СчетУчетаАвансовПолученных = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.5");
                НоваяЗапись.СчетУчетаРасчетовСКомитентом = ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.7");
                НоваяЗапись.СчетУчетаРасчетовПоТареСПоставщиком = ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.1");
                НоваяЗапись.СчетУчетаРасчетовПоТареСПокупателем = ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.1");
                НоваяЗапись.СчетРасчетовПоПретензиям = ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.3");
КонецЦикла;
МассивКолонок = Новый Массив;
Для Каждого КолонкаТЗ Из НаборЗаписейТЗ.Колонки Цикл
                МассивКолонок.Добавить(КолонкаТЗ.Имя);
КонецЦикла;
НаборЗаписейТЗ.Свернуть(СтрСоединить(МассивКолонок, ","));
НаборЗаписей.Загрузить(НаборЗаписейТЗ);
НаборЗаписей.Записать(РежимЗамещения.Слияние);
